{
  "name": "back",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create inventario",
    "db:migrate:local": "wrangler d1 execute inventario --local --file=./migrations/0001_init.sql",
    "db:migrate:prod": "wrangler d1 execute inventario --remote --file=./migrations/0001_init.sql",
    "type-check": "tsc --noEmit"
  },
  "type": "module",
  "dependencies": {
    "hono": "^4.12.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260329.1",
    "typescript": "^6.0.2",
    "wrangler": "^4.78.0"
  }
}
